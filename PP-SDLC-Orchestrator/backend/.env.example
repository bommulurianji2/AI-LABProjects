# Copy to backend/.env (this file's own directory) and adjust as needed.
# Never commit the real .env file. Paths below are relative to backend/,
# since that's the working directory the app and scripts run from.

# SQLAlchemy database URL. Defaults to a local SQLite file in this directory if unset.
# PPSDLC_DATABASE_URL=sqlite:///./pp_sdlc.db

# Overrides for the agent/template/generated-artefact directories (defaults are
# relative to the repo root, one level up from backend/, and normally don't need to be set).
# PPSDLC_AGENT_SKILLS_DIR=../03_Agent_Skills
# PPSDLC_TEMPLATES_DIR=../04_Templates
# PPSDLC_GENERATED_ARTEFACTS_DIR=../05_Generated_Artefacts

# LLM provider (OpenRouter, OpenAI-compatible) — required for any agent whose
# manifest sets `runtime: llm` (currently: Analysis). Get a key at
# https://openrouter.ai/keys. Never commit a real key.
# PPSDLC_OPENROUTER_API_KEY=
# PPSDLC_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# PPSDLC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Deferred to later sessions (not yet read by any code) ---
# Microsoft Entra ID / Graph — required once M365 adapters move off mocks.
# PPSDLC_ENTRA_TENANT_ID=
# PPSDLC_ENTRA_CLIENT_ID=
# PPSDLC_ENTRA_CLIENT_SECRET=

# Azure AI Document Intelligence / Content Safety / Language PII.
# PPSDLC_AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# PPSDLC_AZURE_CONTENT_SAFETY_ENDPOINT=
# PPSDLC_AZURE_LANGUAGE_ENDPOINT=
